# Copy to .env. With no keys set, Saathi runs fully offline using the deterministic "fake" provider.

# --- Free option A (recommended): Google Gemini free tier, get a key at https://aistudio.google.com/apikey
# LLM_PROVIDER=gemini
# EMBEDDING_PROVIDER=gemini
# GEMINI_API_KEY=your-key

# --- Free option B: Groq free tier for chat (pair with gemini or fake embeddings)
# LLM_PROVIDER=openai_compat
# OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_COMPAT_API_KEY=your-key
# OPENAI_COMPAT_MODEL=llama-3.3-70b-versatile

JWT_SECRET=replace-with-a-long-random-string-of-32-plus-chars
